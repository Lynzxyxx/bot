# ===== WAJIB =====
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Admin tambahan (opsional, jumlah bebas):
# ADMIN_PASSWORD2=password-admin-kedua
# ADMIN_PASSWORD3=password-admin-ketiga

# Upstash Redis (penyimpanan file panel). Otomatis terisi jika kamu pasang
# lewat Vercel -> Storage -> Marketplace -> Upstash Redis (nama KV_REST_API_*).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== OPSIONAL =====
# Token bot TIDAK perlu diisi di sini — dibaca dari config script. (Hanya cadangan jika script tidak menyimpannya)
BOT_TOKEN=

# Domain publik jika memakai custom domain (tanpa https://)
PUBLIC_URL=

# Agar tombol "Terapkan versi" di tab Startup bisa mengubah Node.js project Vercel
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# URL Deploy Hook (Settings -> Git -> Deploy Hooks) agar redeploy otomatis
DEPLOY_HOOK_URL=
